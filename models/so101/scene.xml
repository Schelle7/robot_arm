<mujoco model="scene">
  <include file="so101.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="matte_red" rgba="1 0.1 0.1 1" specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"/>

    <!-- Physical camera placeholder to verify placement -->
    <body name="physical_camera" pos="1 0 0.5" xyaxes="0 1 0 -1 0 4">
      <!-- Camera phone body -->
      <geom type="box" size="0.08 0.04 0.01" rgba="0.1 0.1 0.1 1"/>
      <!-- Lens pointing forward (local -z) -->
      <geom type="cylinder" size="0.015 0.01" pos="0 0 -0.01" rgba="0.8 0.9 1 1"/>
      <!-- Camera fixed to the object -->
      <camera name="pixel_cam" pos="0 0 -0.02" mode="fixed" fovy="45"/>
    </body>

    <!-- Target Red Box -->
    <body name="target_box" pos="0.3 0.0 0.05">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" material="matte_red" mass="0.1"/>
    </body>

    <!-- Ghost end-effector marker -->
    <body name="ghost_ee" mocap="true" pos="0.3 0 0.1" quat="1 0 0 0">
      <!-- A visual representation of the gripper -->
      <geom type="mesh" class="visual" mesh="wrist_roll_follower_so101_v1" material="wrist_roll_follower_so101_v1_material" rgba="0 1 0 0.3" contype="0" conaffinity="0"/>
      <geom type="mesh" class="visual" pos="0 0 -0.015" quat="0.5 0.5 0.5 0.5" mesh="moving_jaw_so101_v1" material="moving_jaw_so101_v1_material" rgba="0 1 0 0.3" contype="0" conaffinity="0"/>
      <!-- A small red sphere to show the exact center -->
      <geom type="sphere" size="0.01" rgba="1 0 0 0.5" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
